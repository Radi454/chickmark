{
  "name": "pip-realtime-sideband",
  "version": "1.0.0",
  "exports": "./main.ts",
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.14",
    "ws": "npm:ws@8.18.0",
    "@types/ws": "npm:@types/ws@8.18.1"
  },
  "nodeModulesDir": "none",
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "lineWidth": 90
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "tasks": {
    "test": "deno test -A",
    "check": "deno check main.ts src/**/*.ts",
    "start": "deno run --allow-net --allow-env main.ts"
  }
}
